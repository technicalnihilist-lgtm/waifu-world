; Waifu World — Godot 4 project configuration
; Stage 2: persistent character profiles + replaceable avatar system.
;
; Renderer is Compatibility (OpenGL ES 3.0 / WebGL 2 class hardware) so the app
; runs on low-end Android devices. Portrait only.

config_version=5

[application]

config/name="Waifu World"
config/description="Room-first 3D AI companion for Android."
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Companions="*res://scripts/autoload/companions.gd"
AppSettings="*res://scripts/autoload/app_settings.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.04, 0.03, 0.06, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=0

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=0.0
